[Substrike]
format=1
name=Hypno Rumble
category=Rumble
author=Substrike
tags=rumble, lfo, moving
description=A rumble floor whose lowpass opens and closes with a synced LFO, sixteenth by sixteenth.
[Parameters]
l1.body.pitch_start=448
l1.body.pitch_end=50
l1.body.sweep=120
l1.body.sweep_curve=60
l1.body.hold=30
l1.body.decay=280
l1.body.decay_curve=55
l2.on=On
l2.level=-8
l2.click.type=Noise
l2.click.decay=3
l2.click.filter=High Pass
l2.click.cutoff=5000
l3.on=On
l3.source=Bus
l3.level=2
l3.bus.lane1=On
l3.bus.lane2=Off
l3.bus.lane3=Off
l3.bus.lane4=Off
l3.bus.lane5=Off
l3.bus.lane6=Off
l3.bus.lane7=Off
l3.bus.lane8=Off
l3.slot1.type=Distortion
l3.slot1.model=Valve Stack
l3.slot1.drive=70
l3.slot1.tone=4000
l3.slot2.type=Reverb
l3.slot2.size=100
l3.slot2.decay=2500
l3.slot2.damping=1200
l3.slot2.width=0
l3.slot3.type=Clipper
l3.slot3.drive=30
l3.slot3.knee=60
l3.slot3.ceiling=0
l3.slot4.type=Filter
l3.slot4.mode=LP 24
l3.slot4.cutoff=100
l3.slot4.reso=10
l3.guard.delay=15
l3.guard.fade=30
l3.duck.source=Lane 1
l3.duck.depth=100
l3.duck.release=250
master.mono_below=150
l1.slot1.type=Clipper
l1.slot1.drive=4
l1.slot1.knee=40
mod.lfo1.shape=Triangle
mod.lfo1.sync=1/16
mod.lfo1.retrigger=On
mod.route1.source=LFO 1
mod.route1.dest=L3 Slot 4 B
mod.route1.amount=12
output=-4.3
