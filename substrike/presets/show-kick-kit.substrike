[Substrike]
format=1
name=Kick Kit
category=Showcase
author=Substrike
tags=kit, note filter, multi
description=Four kicks in one: C2 a techno kick, D2 a tuned boom, E2 a hardstyle kick, F2 a soft acoustic one. Each lane listens to its own note.
[Parameters]
l1.body.pitch_start=300
l1.body.pitch_end=50
l1.body.sweep=80
l1.body.hold=30
l1.body.decay=320
l1.on=On
l1.level=0
l1.note=C2
l1.slot1.type=Clipper
l1.slot1.drive=6
l5.on=On
l5.level=-2
l5.note=D2
l5.body.pitch_start=90
l5.body.pitch_end=36.7
l5.body.sweep=50
l5.body.hold=150
l5.body.decay=1400
l5.slot1.type=Distortion
l5.slot1.model=Soft Clip
l5.slot1.drive=25
l6.on=On
l6.level=-3
l6.note=E2
l6.body.pitch_start=3000
l6.body.pitch_end=55
l6.body.sweep=400
l6.body.hold=220
l6.body.decay=180
l6.slot1.type=Distortion
l6.slot1.model=Valve Stack
l6.slot1.drive=75
l6.slot1.output=-6
l4.on=On
l4.level=0
l4.note=F2
l4.resonator.exciter=Mallet
l4.resonator.model=Membrane
l4.resonator.tune=58
l4.resonator.decay=380
l4.resonator.damping=60
master.clip=Soft
output=-0.3
[Curves]
