[Substrike]
format=1
name=Rolling Thunder
category=Rumble
author=Substrike
tags=rumble, delay, rolling, punchy
description=A punchy hard kick on 54 Hz with a fuzzed floor that rolls in sixteenths: the echoes go into the reverb with the kick.
