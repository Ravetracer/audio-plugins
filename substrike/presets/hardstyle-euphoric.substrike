[Substrike]
format=1
name=Euphoric Hardstyle
category=Hardstyle
author=Substrike
tags=hardstyle, tonal, distorted
description=A euphoric hardstyle kick: a punchy attack and a long distorted tail whose pitch climbs back after the drop. It follows the keys, root C2.
[Parameters]
l1.body.pitch_start=3000
l1.body.pitch_end=50
l1.body.sweep=450
l1.body.key_track=100
l1.body.hold=280
l1.body.decay=200
l1.body.decay_curve=60
l2.on=On
l2.level=-8
l2.click.type=Noise
l2.click.decay=4
l2.click.filter=High Pass
l2.click.cutoff=3000
l1.slot1.type=Distortion
l1.slot1.model=Valve Stack
l1.slot1.drive=80
l1.slot1.tone=7000
l1.slot1.output=-6
l1.slot2.type=Clipper
l1.slot2.drive=8
l1.slot2.knee=30
l1.slot3.type=EQ
l1.slot3.low=3
l1.slot3.mid=-5
l1.slot3.mid_freq=400
l1.slot3.high=-2
master.clip=Hard
[Curves]
l1.pitch=0,1,0;0.004,0.8,0;0.02,0.45,0.3;0.08,0.12,0;0.35,0.17,-0.2;1,0,0.2
