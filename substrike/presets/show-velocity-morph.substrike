[Substrike]
format=1
name=Velocity Morph
category=Showcase
author=Substrike
tags=velocity, dynamic, modulation
description=Play it soft and it is a gentle thud; play it hard and it is a distorted, clicky, longer kick. Velocity drives five parameters.
[Parameters]
l1.body.pitch_start=200
l1.body.pitch_end=50
l1.body.sweep=80
l1.body.hold=30
l1.body.decay=250
l1.on=On
l1.level=0
l1.velocity=40
l2.on=On
l2.level=-14
l2.click.type=Noise
l2.click.decay=4
l2.click.filter=High Pass
l2.click.cutoff=3000
l1.slot1.type=Distortion
l1.slot1.model=Valve Stack
l1.slot1.drive=0
mod.route1.source=Velocity
mod.route1.dest=L1 Slot 1 B
mod.route1.amount=70
mod.route1.curve=30
mod.route2.source=Velocity
mod.route2.dest=L1 Pitch Start
mod.route2.amount=25
mod.route3.source=Velocity
mod.route3.dest=L1 Body Decay
mod.route3.amount=15
mod.route4.source=Velocity
