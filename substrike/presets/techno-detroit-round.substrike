[Substrike]
format=1
name=Detroit Round
category=Techno
author=Substrike
tags=warm, round, soulful
description=A warm, rounded kick with soul: a triangle body gently shaped, a soft beater noise and no hard edges.
[Parameters]
l1.body.pitch_start=384
l1.body.pitch_end=55
