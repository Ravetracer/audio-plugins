[Substrike]
format=1
name=Peak Time
category=Techno
author=Substrike
tags=hard techno, loud, big room
description=A big peak-time hard techno kick: a fast, hard attack, an overdriven body and a click that cuts through a wall of sound.
[Parameters]
l1.body.pitch_start=520
l1.body.pitch_end=56
l1.body.sweep=300
l1.body.sweep_curve=55
l1.body.hold=25
l1.body.decay=260
l1.body.shape=40
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=900
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Overdrive
l1.slot2.drive=50
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=450
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=10
l1.slot4.knee=30
l1.slot4.ceiling=0
l2.on=On
l2.level=-6
l2.click.type=Impulse
l2.click.decay=1
l2.click.filter=Low Pass
l2.click.cutoff=6000
l3.on=On
l3.level=-26
l3.noise.color=Pink
l3.noise.filter=Band Pass
l3.noise.cutoff=1800
l3.noise.decay=60
master.clip=Soft
output=-0.4
