[Substrike]
format=1
name=Classic Rumble
category=Rumble
author=Substrike
tags=rumble, hard techno, bus, reverb
description=The rumble floor under a hard kick: a bus lane drives the kick into a big dark reverb, clips the reverb flat into a deep level and ducks under each kick so the floor swells back towards the next.
[Parameters]
l1.body.pitch_start=470
l1.body.pitch_end=55
l1.body.sweep=300
l1.body.sweep_curve=55
l1.body.hold=25
l1.body.decay=260
l1.body.decay_curve=55
l3.on=On
l3.source=Bus
l3.level=2
l3.bus.lane1=On
l3.bus.lane2=Off
l3.bus.lane3=Off
l3.bus.lane4=Off
l3.bus.lane5=Off
l3.bus.lane6=Off
l3.bus.lane7=Off
l3.bus.lane8=Off
l3.slot1.type=Distortion
l3.slot1.model=Valve Stack
l3.slot1.drive=70
l3.slot1.tone=4000
l3.slot2.type=Reverb
l3.slot2.size=100
l3.slot2.decay=2500
l3.slot2.damping=1200
l3.slot2.width=0
l3.slot3.type=Clipper
l3.slot3.drive=30
l3.slot3.knee=60
l3.slot3.ceiling=0
l3.slot4.type=Filter
l3.slot4.mode=LP 24
l3.slot4.cutoff=110
l3.slot4.reso=10
l3.guard.delay=15
l3.guard.fade=30
l3.duck.source=Lane 1
l3.duck.depth=100
l3.duck.release=250
master.mono_below=150
l1.body.shape=40
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=750
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Soft Clip
l1.slot2.drive=40
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=360
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=6
l1.slot4.knee=30
l1.slot4.ceiling=0
l2.on=On
l2.level=-7
l2.click.type=Impulse
l2.click.decay=1
l2.click.filter=Low Pass
l2.click.cutoff=6000
output=-5.1
