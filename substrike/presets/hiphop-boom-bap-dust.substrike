[Substrike]
format=1
name=Boom Bap Dust
category=Hip Hop
author=Substrike
tags=boom bap, dusty, lo-fi
description=A dusty boom bap kick: crunched to twelve bits, rolled off at the top, with vinyl crackle riding on it.
[Parameters]
l1.body.pitch_start=210
l1.body.pitch_end=55
l1.body.sweep=60
l1.body.hold=40
l1.body.decay=300
l1.body.wave=Triangle
l1.body.shape=20
l4.on=On
l4.level=-14
l4.resonator.exciter=Mallet
l4.resonator.tune=95
l4.resonator.decay=150
l4.resonator.damping=60
l3.on=On
l3.level=-30
l3.noise.color=Crackle
l3.noise.density=40
l3.noise.filter=Band Pass
l3.noise.cutoff=3000
l3.noise.hold=200
l3.noise.decay=200
master.slot1.type=Bitcrush
master.slot1.bits=12
master.slot1.rate=26000
master.slot2.type=Filter
master.slot2.mode=LP 12
master.slot2.cutoff=6000
master.slot2.reso=10
master.slot3.type=Compressor
master.slot3.threshold=-20
master.slot3.ratio=4
master.slot3.attack=10
master.slot3.release=100
master.slot3.makeup=3
output=-3.5
