[Substrike]
format=1
name=Hydraulic Press
category=Techno
author=Substrike
tags=hard techno, industrial, noise
description=An industrial hard techno hit: a fuzzed body and a burst of filtered noise slamming in with it.
[Parameters]
l1.body.pitch_start=430
l1.body.pitch_end=52
l1.body.sweep=260
l1.body.sweep_curve=55
l1.body.hold=25
l1.body.decay=260
l1.body.shape=35
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=700
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Fuzz
l1.slot2.drive=45
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=380
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=8
l1.slot4.knee=30
l1.slot4.ceiling=0
l2.on=On
l2.level=-8
l2.click.type=Noise
l2.click.decay=3
l2.click.filter=High Pass
l2.click.cutoff=4000
l3.on=On
l3.level=-16
l3.noise.color=White
l3.noise.filter=Band Pass
l3.noise.cutoff=1200
l3.noise.reso=40
l3.noise.filter_env=2
l3.noise.env_decay=40
l3.noise.decay=90
master.slot1.type=Compressor
master.slot1.threshold=-16
master.slot1.ratio=4
master.slot1.attack=5
master.slot1.release=80
master.slot1.makeup=3
output=-2.8
