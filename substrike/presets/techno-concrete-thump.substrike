[Substrike]
format=1
name=Concrete Thump
category=Techno
author=Substrike
tags=hard techno, overdriven, punchy
description=A hard, overdriven techno kick: a long drop onto 55 Hz, a saturated body clipped into a solid block, a sharp click.
[Parameters]
l1.body.pitch_start=450
l1.body.pitch_end=55
l1.body.sweep=280
l1.body.sweep_curve=55
l1.body.hold=25
l1.body.decay=260
l1.body.shape=35
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=800
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Soft Clip
l1.slot2.drive=45
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=400
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=6
l1.slot4.knee=30
l1.slot4.ceiling=0
l2.on=On
l2.level=-8
l2.click.type=Impulse
l2.click.decay=1
l2.click.filter=Low Pass
l2.click.cutoff=6000
output=-1
