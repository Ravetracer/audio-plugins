[Substrike]
format=1
name=Broken Robot
category=Experimental
author=Substrike
tags=robotic, folded, ring
description=A malfunctioning machine: folded, ring-modulated and crushed, with a stuttering pitch.
[Parameters]
l1.body.pitch_start=400
l1.body.pitch_end=60
l1.body.sweep=60
l1.body.hold=60
l1.body.decay=260
l1.slot1.type=Wavefolder
l1.slot1.drive=15
l1.slot1.shape=70
