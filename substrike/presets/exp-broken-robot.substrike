l1.slot2.mix=60
l1.slot2.mode=Ring
l1.slot2.freq=95
l1.slot2.env=3
l1.slot2.env_decay=100
l1.slot3.type=Bitcrush
l1.slot3.mix=70
l1.slot3.bits=7
l1.slot3.rate=9000
mod.lfo1.shape=Square
mod.lfo1.rate=24
mod.lfo1.retrigger=On
mod.route1.source=LFO 1
