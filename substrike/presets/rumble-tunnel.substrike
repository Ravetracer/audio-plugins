[Substrike]
format=1
name=Tunnel Pressure
category=Rumble
author=Substrike
tags=rumble, warp, diffuse, smooth
description=A long, rounded 46 Hz kick over a smooth, diffuse floor: soft clipping and a Warp full of diffusion, so it breathes like air in a tunnel.
[Parameters]
l1.body.pitch_start=384
l1.body.pitch_end=46
l1.body.sweep=165
l1.body.sweep_curve=50
l1.body.hold=60
l1.body.decay=380
l1.body.wave=Triangle
l1.body.shape=10
l2.on=On
l2.level=-14
l2.click.type=Noise
l2.click.decay=4
l2.click.filter=Band Pass
l2.click.cutoff=2200
l3.on=On
l3.source=Bus
l3.level=2
l3.bus.lane1=On
l3.bus.lane2=Off
l3.bus.lane3=Off
l3.bus.lane4=Off
l3.bus.lane5=Off
l3.bus.lane6=Off
l3.bus.lane7=Off
l3.bus.lane8=Off
l3.slot1.type=Distortion
l3.slot1.model=Tube
l3.slot1.drive=50
l3.slot1.tone=4000
l3.slot2.type=Reverb
l3.slot2.size=100
l3.slot2.decay=2200
l3.slot2.damping=2000
l3.slot2.width=0
l3.slot3.type=Clipper
l3.slot3.drive=24
l3.slot3.knee=100
l3.slot3.ceiling=0
