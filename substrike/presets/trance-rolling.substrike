[Substrike]
format=1
name=Rolling Offbeat
category=Trance
author=Substrike
tags=rolling, bus, offbeat
description=A trance kick with a short rolling tail from a bus lane, ducked so the next bass note has room.
[Parameters]
l1.body.pitch_start=480
l1.body.pitch_end=50
l1.body.sweep=120
l1.body.hold=30
l1.body.decay=300
l3.on=On
l3.source=Bus
l3.level=-8
l3.bus.lane1=On
l3.bus.lane2=Off
l3.bus.lane3=Off
l3.bus.lane4=Off
l3.bus.lane5=Off
l3.bus.lane6=Off
l3.bus.lane7=Off
l3.bus.lane8=Off
l3.slot1.type=Distortion
l3.slot1.model=Tube
l3.slot1.drive=60
l3.slot2.type=Reverb
l3.slot2.size=30
l3.slot2.decay=700
l3.slot2.damping=3000
l3.slot3.type=Filter
l3.slot3.mode=LP 24
l3.slot3.cutoff=140
l3.slot4.type=Gate
l3.slot4.mode=Hit
l3.slot4.hold=120
l3.slot4.release=40
l3.guard.delay=20
l3.guard.fade=30
l3.duck.source=Lane 1
l3.duck.depth=60
l3.duck.release=120
output=-1
