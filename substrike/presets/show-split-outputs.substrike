[Substrike]
format=1
name=Split Outputs
category=Showcase
author=Substrike
tags=aux outputs, routing, mixing
description=A kick with a rumble floor, spread over the outputs: the body on the main output and its own, the click and the rumble on theirs only, to mix and sidechain in the DAW.
[Parameters]
l1.body.pitch_start=300
l1.body.pitch_end=50
l1.body.sweep=80
l1.body.hold=30
l1.body.decay=300
l1.on=On
l1.level=0
l1.output=Main+Aux
l2.on=On
l2.level=-12
l2.output=Aux
l2.click.type=Noise
l2.click.decay=4
l2.click.filter=High Pass
l2.click.cutoff=4000
l3.on=On
l3.source=Bus
l3.level=2
l3.output=Aux
l3.bus.lane1=On
l3.bus.lane2=Off
l3.bus.lane3=Off
l3.bus.lane4=Off
l3.bus.lane5=Off
l3.bus.lane6=Off
l3.bus.lane7=Off
l3.bus.lane8=Off
l3.slot1.type=Distortion
l3.slot1.model=Valve Stack
l3.slot1.drive=70
l3.slot2.type=Reverb
l3.slot2.size=100
l3.slot2.decay=2500
l3.slot2.damping=1200
l3.slot2.width=0
l3.slot3.type=Clipper
l3.slot3.drive=30
l3.slot3.knee=60
l3.slot3.ceiling=0
l3.slot4.type=Filter
l3.slot4.mode=LP 24
l3.slot4.cutoff=110
l3.slot4.reso=10
l3.guard.delay=15
l3.guard.fade=30
output=-1
