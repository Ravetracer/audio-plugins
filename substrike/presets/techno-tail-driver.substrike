[Substrike]
format=1
name=Tail Driver
category=Techno
author=Substrike
tags=hard techno, long tail, overdriven
description=A hard kick with a long, driven tail that hums on 52 Hz under the groove.
[Parameters]
l1.body.pitch_start=420
l1.body.pitch_end=52
l1.body.sweep=360
l1.body.sweep_curve=55
l1.body.hold=150
l1.body.decay=320
l1.body.shape=45
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=600
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Crunch
l1.slot2.drive=55
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=280
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=8
l1.slot4.knee=30
l1.slot4.ceiling=0
l2.on=On
l2.level=-9
l2.click.type=Noise
l2.click.decay=3
l2.click.filter=High Pass
l2.click.cutoff=4000
output=-1
