[Substrike]
format=1
name=Brick Wall
category=Techno
author=Substrike
tags=hard techno, compressed, brick
description=A brick of a kick: saturated hard, clipped flat and limited, so its body stays at full level until it stops.
[Parameters]
l1.body.pitch_start=500
l1.body.pitch_end=58
l1.body.sweep=260
l1.body.sweep_curve=55
l1.body.hold=60
l1.body.decay=220
l1.body.shape=60
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=650
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Tube
l1.slot2.drive=60
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=350
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=12
l1.slot4.knee=0
l1.slot4.ceiling=0
l2.on=On
l2.level=-8
l2.click.type=Impulse
l2.click.decay=1
l2.click.filter=Low Pass
l2.click.cutoff=6000
master.clip=Limit
output=-0.7
