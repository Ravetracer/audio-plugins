[Substrike]
format=1
name=Schranz Hammer
category=Techno
author=Substrike
tags=schranz, fast, distorted
description=A fast, hammering schranz kick: short, high and rectified, for 150 BPM and up.
[Parameters]
l1.body.pitch_start=600
l1.body.pitch_end=62
l1.body.sweep=180
l1.body.sweep_curve=55
l1.body.hold=20
l1.body.decay=190
l1.body.shape=50
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=1200
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Rectifier
l1.slot2.drive=50
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=550
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=10
l1.slot4.knee=30
l1.slot4.ceiling=0
l2.on=On
l2.level=-6
l2.click.type=Zap
l2.click.decay=1
l2.click.filter=Off
