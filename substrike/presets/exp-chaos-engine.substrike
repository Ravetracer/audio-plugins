[Substrike]
format=1
name=Chaos Engine
category=Experimental
author=Substrike
tags=chaos, random, modulated
description=Nothing stays put: random values and free LFOs move the pitch, the decay, the drive, the filter and the noise on every hit.
[Parameters]
l1.body.pitch_start=350
l1.body.pitch_end=50
l1.body.sweep=90
l1.body.hold=30
l1.body.decay=320
l3.on=On
l3.level=-18
l3.noise.color=Pink
l3.noise.filter=Band Pass
l3.noise.cutoff=2000
l3.noise.reso=50
l3.noise.decay=120
l1.slot1.type=Distortion
l1.slot1.model=Germanium
l1.slot1.drive=40
l1.slot2.type=Filter
l1.slot2.mix=40
l1.slot2.mode=Band Pass
l1.slot2.cutoff=800
l1.slot2.reso=30
mod.lfo1.shape=Smooth
mod.lfo1.rate=1.7
mod.lfo1.retrigger=Off
mod.lfo2.shape=S&H
mod.lfo2.rate=0.9
mod.lfo2.retrigger=Off
mod.route1.source=Random
mod.route1.dest=L1 Pitch End
mod.route1.amount=8
mod.route2.source=Random
mod.route2.dest=L1 Body Decay
mod.route2.amount=15
mod.route3.source=LFO 1
mod.route3.dest=L1 Slot 1 B
mod.route3.amount=40
mod.route4.source=LFO 2
mod.route4.dest=L1 Slot 2 B
mod.route4.amount=40
mod.route5.source=LFO 1
mod.route5.dest=L3 Noise Cutoff
mod.route5.amount=30
mod.route6.source=LFO 2
mod.route6.dest=L1 Sweep Time
mod.route6.amount=20
output=2.5
