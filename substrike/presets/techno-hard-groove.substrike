[Substrike]
format=1
name=Hard Groove
category=Techno
author=Substrike
tags=hard groove, round, saturated
description=A rounder hard groove kick: the same long drop and saturation, but softer clipping and more room on top.
[Parameters]
l1.body.pitch_start=380
l1.body.pitch_end=53
l1.body.sweep=250
l1.body.sweep_curve=55
l1.body.hold=30
l1.body.decay=280
l1.body.shape=30
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=1000
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Soft Clip
l1.slot2.drive=30
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=600
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=4
l1.slot4.knee=60
l1.slot4.ceiling=0
l2.on=On
l2.level=-10
l2.click.type=Impulse
l2.click.decay=1
l2.click.filter=Low Pass
l2.click.cutoff=6000
output=-1
