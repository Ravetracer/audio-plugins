[Substrike]
format=1
name=Studio Kick
category=Acoustic
author=Substrike
tags=acoustic, drum kit, studio
description=A studio bass drum: a tuned skin, a body under it, a felt beater and a small room, compressed like a close mic.
[Parameters]
l1.on=On
l1.source=Resonator
l1.level=0
l1.resonator.exciter=Mallet
l1.resonator.model=Membrane
l1.resonator.modes=8
l1.resonator.tune=58
l1.resonator.decay=380
l1.resonator.damping=60
l1.resonator.brightness=35
l1.resonator.hardness=45
l1.resonator.drop=3
l1.resonator.drop_time=25
l5.on=On
l5.level=-6
l5.body.pitch_start=140
l5.body.pitch_end=52
l5.body.sweep=50
l5.body.hold=20
l5.body.decay=240
l2.on=On
l2.level=-12
l2.click.type=Noise
l2.click.decay=5
l2.click.filter=Band Pass
l2.click.cutoff=3000
l2.click.reso=30
master.slot1.type=Compressor
master.slot1.threshold=-18
master.slot1.ratio=4
master.slot1.attack=8
master.slot1.release=100
master.slot1.makeup=3
master.slot2.type=Reverb
master.slot2.mix=12
master.slot2.size=20
master.slot2.decay=450
master.slot2.damping=5000
output=-2.7
