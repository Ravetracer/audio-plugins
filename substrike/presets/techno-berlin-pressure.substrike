[Substrike]
format=1
name=Berlin Pressure
category=Techno
author=Substrike
tags=hard techno, heavy, saturated, long
description=A heavy, long hard techno kick: a slow drop onto 50 Hz through a valve stack, held back by lowpasses so it is thick, not fizzy.
[Parameters]
l1.body.pitch_start=400
l1.body.pitch_end=50
l1.body.sweep=340
l1.body.sweep_curve=55
l1.body.hold=40
l1.body.decay=330
l1.body.shape=45
l1.body.wave=Sine
l1.velocity=0
l1.slot1.type=Filter
l1.slot1.mode=LP 12
l1.slot1.cutoff=600
l1.slot1.reso=10
l1.slot2.type=Distortion
l1.slot2.model=Valve Stack
l1.slot2.drive=55
l1.slot2.tone=20000
l1.slot3.type=Filter
l1.slot3.mode=LP 24
l1.slot3.cutoff=300
l1.slot3.reso=10
l1.slot4.type=Clipper
l1.slot4.drive=8
l1.slot4.knee=30
l1.slot4.ceiling=0
l2.on=On
l2.level=-10
l2.click.type=Noise
l2.click.decay=3
l2.click.filter=High Pass
l2.click.cutoff=4000
master.slot1.type=Compressor
master.slot1.threshold=-16
master.slot1.ratio=4
master.slot1.attack=10
master.slot1.release=120
master.slot1.makeup=2
output=-1.6
