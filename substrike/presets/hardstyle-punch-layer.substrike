[Substrike]
format=1
name=Layered Punch
category=Hardstyle
author=Substrike
tags=hardstyle, layered, punch
description=Three layers the way hardstyle producers build them: a punch, a distorted tail on a bus, and a click, each with its own chain.
[Parameters]
l1.body.pitch_start=4000
l1.body.pitch_end=60
l1.body.sweep=250
l1.body.hold=10
l1.body.decay=110
l1.slot1.type=Clipper
l1.slot1.drive=10
l1.slot1.knee=20
l5.on=On
l5.level=-2
l5.body.pitch_start=200
l5.body.pitch_end=52
l5.body.sweep=120
l5.body.key_track=100
l5.body.hold=250
l5.body.decay=180
l5.slot1.type=Distortion
l5.slot1.model=Valve Stack
l5.slot1.drive=85
l5.slot1.output=-6
l5.slot2.type=Filter
l5.slot2.mode=LP 24
l5.slot2.cutoff=1500
l5.slot2.reso=20
l5.guard.delay=15
l5.guard.fade=25
l2.on=On
l2.level=-10
l2.click.type=Noise
l2.click.decay=2.5
l2.click.filter=High Pass
l2.click.cutoff=5000
master.clip=Hard
[Curves]
l1.pitch=0,1,0;0.005,0.78,0;0.03,0.35,0.3;0.15,0.1,0.2;1,0,0
