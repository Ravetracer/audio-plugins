# Turns third_party/hermidi/HerMIDI-PIC.hex into a header holding the hex text.
#   cmake -DHEX=... -DOUTPUT=... -P embed_hermidi.cmake
file(READ "${HEX}" text)
set(body "// Generated by cmake/embed_hermidi.cmake from third_party/hermidi -- do not edit.\n#pragma once\n\n")
string(APPEND body "namespace sidmidi::emu {\ninline const char* const kHerMidiFirmwareHex = R\"HEX(${text})HEX\";\n}\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
    if(old STREQUAL body)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${body}")
