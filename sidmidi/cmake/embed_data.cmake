# Writes the VICE palettes in palettes/*.vpl into a header, as text, so they
# travel inside the plugin. (The Commodore ROMs never do: the user puts them
# into SidMidi's ROM folder.)
#
#   cmake -DPALETTE_DIR=... -DOUTPUT=... -P embed_data.cmake

if(NOT PALETTE_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "embed_data.cmake: PALETTE_DIR and OUTPUT are required")
endif()

set(body "// Generated by cmake/embed_data.cmake -- do not edit.\n#pragma once\n\n")
string(APPEND body "namespace sidmidi::embedded {\n\n")

file(GLOB palettes "${PALETTE_DIR}/*.vpl")
list(SORT palettes)
string(APPEND body "struct EmbeddedPalette\n{\n    const char* key;\n    const char* text;\n};\n\n")
string(APPEND body "inline const EmbeddedPalette kPalettes[] = {\n")
foreach(p ${palettes})
    get_filename_component(key "${p}" NAME_WE)
    file(READ "${p}" text)
    string(APPEND body "    {\"${key}\", R\"VPL(${text})VPL\"},\n")
endforeach()
string(APPEND body "};\n")
string(APPEND body "inline constexpr int kNumPalettes = static_cast<int>(sizeof(kPalettes) / sizeof(kPalettes[0]));\n\n")
string(APPEND body "} // namespace sidmidi::embedded\n")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
    if(old STREQUAL body)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${body}")
