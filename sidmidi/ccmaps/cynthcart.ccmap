# SidMidi CC map: slot = CC[@channel] name [| value label, value label ...]
# Cynthcart 2.0.1 (Paul Slocum). It listens on every channel at start. CCs
# 16-31 act as 0-15, 32 and up do nothing. cynthcart_emu.prg is built with
# MIDI controllers switched off.
name = Cynthcart
programs = cynthcart
channel = 1
1 = 1 Cutoff
2 = 0 Resonance
3 = 2 Voice Mode | 0 Poly, 8 5ths, 16 5Port, 24 Port1, 32 Port2, 40 Port3, 48 Mono1, 56 Mono2, 64 MonP1, 72 MonP2, 80 Arp1, 88 Arp2, 96 Arp3, 104 Arp4, 112 Arp5, 120 6Chan
4 = 3 Modulation | 0 None, 16 Filt1, 32 Filt2, 48 Filt3, 64 Filt4, 80 Filt5, 96 Puls1, 112 Puls2
5 = 4 Attack
6 = 5 Release
7 = 6 Pulse Width
8 = 7 Volume
9 = 13 Waveform | 0 Tri, 8 Saw, 16 Pulse, 24 Noise, 32 Tri, 40 Saw, 48 Pulse, 56 Noise, 64 Tri, 72 Saw, 80 Pulse, 88 Noise, 96 Tri, 104 Saw, 112 Pulse, 120 Noise
10 = 14 Wave Voice 2 | 0 Tri, 8 Saw, 16 Pulse, 24 Noise, 32 Tri, 40 Saw, 48 Pulse, 56 Noise, 64 Tri, 72 Saw, 80 Pulse, 88 Noise, 96 Tri, 104 Saw, 112 Pulse, 120 Noise
11 = 15 Wave Voice 3 | 0 Tri, 8 Saw, 16 Pulse, 24 Noise, 32 Tri, 40 Saw, 48 Pulse, 56 Noise, 64 Tri, 72 Saw, 80 Pulse, 88 Noise, 96 Tri, 104 Saw, 112 Pulse, 120 Noise
12 = 8 Tremolo Depth | 0 0, 16 1, 32 2, 48 3, 64 0, 80 1, 96 2, 112 3
13 = 9 Tremolo Speed | 0 0, 16 1, 32 2, 48 3, 64 0, 80 1, 96 2, 112 3
