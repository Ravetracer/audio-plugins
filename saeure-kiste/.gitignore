# Reference material: the TB-303 service-note PDFs. Roland's, not ours to
# redistribute. The root .gitignore already covers */\!dev/; this repeats it so
# the rule travels with the folder.
/\!dev/

# Build trees and renders. demos/ is everything rendered for listening --
# WAVs, MP3s and the notes that go with them -- and none of it belongs in the
# repository: it is output, it is large, and it is regenerated in a minute.
/build/
/build-*/
/demos/
*.wav
