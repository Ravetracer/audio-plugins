# SaeureKiste preset
format = 1
name = Machine Running
author = SaeureKiste
description = Mode set to Sequencer, so the plugin plays itself: press play in the host and the pattern runs, locked to the timeline. A held MIDI note transposes it rather than sounding -- C2 is the pattern as written -- which is what the machine's own keyboard did. Sixteen steps, three slides and four accents, at the settings the rest of the library was built around.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 440
resonance = 0.72
envmod = 0.72
decay = 380
tracking = 0

# Accent
accent = 0.7
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 60

# Drive
drive = 0.3
tone = 9500

# Output
volume = -7

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = Sequencer
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06

# Sequence
seq_pitch   = C   C   C   .   D#  C   C   G   C   .   A#  C   C   G   C   .
seq_octave  = .   .   +   .   .   .   .   .   .   .   .   +   .   .   .   .
seq_slide   = .   x   .   .   .   .   x   .   .   .   .   x   .   .   x   .
seq_accent  = x   .   .   .   x   .   .   x   .   .   x   .   .   x   .   .
seq_vibrato = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
