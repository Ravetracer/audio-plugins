# SaeureKiste preset
format = 1
name = Sub Roll
author = SaeureKiste
description = No sweep at all: Env Mod at zero, so Q9's bias trick is not shifting anything and the Cutoff knob means exactly what it says. A plain filtered oscillator, for the bars where the line is holding the bottom of the arrangement rather than being the arrangement.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 260
resonance = 0.2
envmod = 0
decay = 400
tracking = 0

# Accent
accent = 0.4
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 45

# Drive
drive = 0.1
tone = 4000

# Output
volume = -5

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
