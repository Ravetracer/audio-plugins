# SaeureKiste preset
format = 1
name = Accent Pump
author = SaeureKiste
description = Sweep Time at 180 ms, well past the 68 ms the circuit's own C62 and R138 give it. Each accent then has not left the filter by the time the next one arrives, so a run of them builds instead of repeating, and the notes between them are brighter than they would be on their own. This is the behaviour the hardware has a little of and this preset has a lot of.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 380
resonance = 0.7
envmod = 0.75
decay = 350
tracking = 0

# Accent
accent = 0.85
accent_threshold = 90
accent_decay = 180

# Slide
slide_time = 60

# Drive
drive = 0.3
tone = 10000

# Output
volume = -7

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06

# Sequence
seq_pitch   = C   C   C   C   C   C   C   C   C   C   C   C   C   C   C   C
seq_octave  = .   .   +   .   .   .   +   .   .   .   +   .   .   +   .   .
seq_slide   = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
seq_accent  = x   .   .   x   .   x   .   .   x   .   .   x   .   x   .   .
seq_vibrato = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
