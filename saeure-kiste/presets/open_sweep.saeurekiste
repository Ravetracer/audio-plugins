# SaeureKiste preset
format = 1
name = Open Sweep
author = SaeureKiste
description = A long fall. Decay at 1.6 seconds is past the length of a bar at any tempo anybody writes acid at, so the filter never finishes closing before the next note reopens it and the line reads as one long movement rather than as separate notes.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 700
resonance = 0.6
envmod = 0.65
decay = 1600
tracking = 0

# Accent
accent = 0.55
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 60

# Drive
drive = 0.15
tone = 12000

# Output
volume = -7

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
