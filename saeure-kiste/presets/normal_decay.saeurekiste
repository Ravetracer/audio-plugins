# SaeureKiste preset
format = 1
name = Normal Decay
author = SaeureKiste
description = Acc Decay set to the same value as Decay, which is the one modification people asked for more than any other. On the machine an accented note is forced onto a fixed short envelope by a 4066 switch on the ACCENT line, whatever the Decay knob says -- so an accent is always a stab. Match the two and an accent stops being shorter: it is still louder and still brighter, and it now sustains like everything else. The Devil Fish put a toggle on the front panel for exactly this.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 460
resonance = 0.7
envmod = 0.7
decay = 900
tracking = 0

# Accent
accent = 0.7
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 60

# Drive
drive = 0.3
tone = 9000

# Output
volume = -7

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 900
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
