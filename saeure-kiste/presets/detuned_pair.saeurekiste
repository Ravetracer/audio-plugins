# SaeureKiste preset
format = 1
name = Detuned
author = SaeureKiste
description = Tuning down 14 cents. The control's range is the plus or minus 700 cents the service notes give it, so it is a transposition control as much as a tuning one -- but what it is actually for is this: a few cents off, against anything else in the track that is exactly in tune.

# VCO
waveform = Sawtooth
tuning = -14

# VCF
cutoff = 610
resonance = 0.68
envmod = 0.62
decay = 450
tracking = 0

# Accent
accent = 0.6
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 60

# Drive
drive = 0.28
tone = 9500

# Output
volume = -7

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
