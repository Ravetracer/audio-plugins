# SaeureKiste preset
format = 1
name = Long Fall
author = SaeureKiste
description = Decay at the knob's maximum, 2.5 seconds, which is the figure printed on the schematic beside the envelope curve. Resonance is moderate because at this length a high peak would sit on one pitch for long enough to become a tone of its own.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 900
resonance = 0.45
envmod = 0.7
decay = 2500
tracking = 0

# Accent
accent = 0.5
accent_threshold = 100
accent_decay = 120

# Slide
slide_time = 60

# Drive
drive = 0.1
tone = 14000

# Output
volume = -8

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06

# Sequence
seq_pitch   = C   .   .   D#  .   .   G   .   A#  .   .   G   .   .   D#  .
seq_octave  = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
seq_slide   = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
seq_accent  = x   .   .   .   .   .   x   .   x   .   .   .   .   .   .   .
seq_vibrato = .   .   .   x   .   .   .   .   .   .   .   x   .   .   .   .
