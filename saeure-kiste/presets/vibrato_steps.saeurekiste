# SaeureKiste preset
format = 1
name = Vibrato Steps
author = SaeureKiste
description = A vibrato on four of the sixteen steps, which is a modification rather than a machine: nothing in the TB-303 bends a note. The delay is 90 ms so it arrives after the note has started rather than wobbling from the first cycle, and the depth is 40 cents, which is wide enough to hear and narrow enough not to sound out of tune. A slide does not restart the wait, so a slid pair keeps its vibrato.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 520
resonance = 0.6
envmod = 0.6
decay = 700
tracking = 0

# Accent
accent = 0.6
accent_threshold = 100
accent_decay = 90

# Slide
slide_time = 70

# Drive
drive = 0.22
tone = 11000

# Output
volume = -7

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = Sequencer
seq_rate = 1/8
seq_steps = 8
gate = 0.8
swing = 50

# Vibrato
vib_depth = 40
vib_rate = 5.5
vib_delay = 90

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06

# Sequence
seq_pitch   = C   .   D#  G   .   A#  G   .   .   .   .   .   .   .   .   .
seq_octave  = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
seq_slide   = .   .   x   .   .   .   .   .   .   .   .   .   .   .   .   .
seq_accent  = x   .   .   x   .   .   .   .   .   .   .   .   .   .   .   .
seq_vibrato = .   .   .   x   .   x   x   .   .   .   .   .   .   .   .   .
