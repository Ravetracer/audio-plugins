# RumpelKiste preset
format = 1
name = Warehouse
author = RumpelKiste
description = Four patterns chained, about 130 BPM: the floor, then a rim shot working against it, then the ride, then a tom fill back to the top. A longer kick with its sweep held up by Tune, and the snare tail pulled short so the claps carry the backbeat.

# Bass Drum
bd_tune = 0.68
bd_level = 0.8
bd_attack = 0.7
bd_decay = 190

# Snare Drum
sd_tune = 0.5
sd_level = 0.8
sd_tone = 0.35
sd_snappy = 0.5

# Low Tom
lt_tune = 0.5
lt_level = 0.8
lt_decay = 150

# Mid Tom
mt_tune = 0.5
mt_level = 0.8
mt_decay = 150

# Hi Tom
ht_tune = 0.5
ht_level = 0.8
ht_decay = 150

# Rim / Clap
rs_level = 0.7
cp_level = 0.75

# Hi-Hat
hh_level = 0.7
ch_decay = 24
oh_decay = 260

# Crash
cr_level = 0.6
cr_tune = 0.5

# Ride
rd_level = 0.5
rd_tune = 0.5

# Master
accent = 0.7
volume = -6.9
accent_threshold = 100

# Sequencer
mode = Sequencer
scale = 1/16
steps = 16
shuffle = 1
flam = 3
pattern = 1
chain_mode = Stay
chain_length = 4
pattern_trigger = At End
chain_repeat = 1

# Generator
gen_seed = 1
gen_style = House
gen_busy = 0.5
gen_accent = 0.35

# Mods
bd_pitch = 50
bd_sweep = 5.6
bd_shape = 0.5
sd_pitch = 174
tom_pitch = 86
tom_sweep = 0.5
tom_noise = 0.5
rs_decay = 47
cp_spread = 10.6
hat_color = 0.5
cym_color = 0.5
dac_bits = 6
local_accent = 0.6
shuffle_unit = 8.33
flam_unit = 4
flam_grace = 0.6

# Drive
drive_mode = Off
dist_type = Soft Clip
drive = 0.35
dist_bias = 0
drive_tone = 8000
dist_mix = 1

# Drive Route
route_bd = Dry
route_sd = Dry
route_lt = Dry
route_mt = Dry
route_ht = Dry
route_rs = Dry
route_cp = Dry
route_ch = Dry
route_oh = Dry
route_cr = Dry
route_rd = Dry

# Pattern bank
p1_bd = x... x... x... x...
p1_oh = ..x. ..x. ..x. ..x.
p1_ch = x..x x..x x..x x..x
p1_cp = .... x... .... x...
p1_ac = ..x. ..x. ..x. ..x.
p1_chain = Next
p2_bd = x... x... x... x...
p2_oh = ..x. ..x. ..x. ..x.
p2_ch = x..x x..x x..x x..x
p2_cp = .... x... .... x...
p2_rs = ..x. .x.. x..x ..x.
p2_ac = ..x. ..x. ..x. ..x.
p2_chain = Next
p3_bd = x... x... x... x...
p3_oh = ..x. ..x. ..x. ..x.
p3_rd = x.x. x.x. x.x. x.x.
p3_cp = .... x... .... x...
p3_rs = ..x. .x.. x..x ..x.
p3_ac = ..x. ..x. ..x. ..x.
p3_chain = Next
p4_bd = x... x... x... x.x.
p4_oh = ..x. ..x. .... ....
p4_sd = .... x... ..x. xxXX
p4_ht = .... .... x... ....
p4_mt = .... .... ..x. ....
p4_lt = .... .... .... x..x
p4_ac = ..x. ..x. .... ..xx
p4_chain = Next
