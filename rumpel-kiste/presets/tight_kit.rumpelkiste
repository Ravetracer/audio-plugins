# RumpelKiste preset
format = 1
name = Tight Kit
author = RumpelKiste
description = A kit and nothing else, for under a busy pattern: short, clicky kick, a snare with its tail cut and plenty of snap, closed hats barely longer than a tick.

# Bass Drum
bd_tune = 0.35
bd_level = 0.8
bd_attack = 0.9
bd_decay = 55

# Snare Drum
sd_tune = 0.7
sd_level = 0.8
sd_tone = 0.1
sd_snappy = 0.75

# Low Tom
lt_tune = 0.5
lt_level = 0.8
lt_decay = 90

# Mid Tom
mt_tune = 0.5
mt_level = 0.8
mt_decay = 90

# Hi Tom
ht_tune = 0.5
ht_level = 0.8
ht_decay = 90

# Rim / Clap
rs_level = 0.7
cp_level = 0.7

# Hi-Hat
hh_level = 0.7
ch_decay = 12
oh_decay = 160

# Crash
cr_level = 0.6
cr_tune = 0.5

# Ride
rd_level = 0.6
rd_tune = 0.5

# Master
accent = 0.7
volume = 0
accent_threshold = 100



# Mods
bd_pitch = 50
bd_sweep = 5.6
bd_shape = 0.5
sd_pitch = 174
tom_pitch = 86
tom_sweep = 0.5
tom_noise = 0.5
rs_decay = 47
cp_spread = 10.6
hat_color = 0.65
cym_color = 0.5
dac_bits = 6
local_accent = 0.6
shuffle_unit = 8.33
flam_unit = 4
flam_grace = 0.6

# Drive
drive_mode = Off
dist_type = Soft Clip
drive = 0.35
dist_bias = 0
drive_tone = 8000
dist_mix = 1

# Drive Route
route_bd = Dry
route_sd = Dry
route_lt = Dry
route_mt = Dry
route_ht = Dry
route_rs = Dry
route_cp = Dry
route_ch = Dry
route_oh = Dry
route_cr = Dry
route_rd = Dry
