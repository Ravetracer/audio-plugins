# ThreeOhThree preset
format = 1
name = Screamer
author = ThreeOhThree
description = Resonance near the top of its travel with the drive stage hard into its clipper. The ladder's own saturation is what stops the resonance running away -- the filter is transistors and transistors run out of headroom -- so this gets louder and harder rather than turning into a sine wave.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 560
resonance = 0.92
envmod = 0.85
decay = 260
tracking = 0

# Accent
accent = 0.9
accent_threshold = 95
accent_decay = 68

# Slide
slide_time = 50

# Drive
drive = 0.8
tone = 7000

# Output
volume = -9

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06

# Sequence
seq_pitch   = C   C   A#  C   G   C   D#  C   C   A#  C   G   C   D#  C   C
seq_octave  = .   +   .   .   .   +   .   .   .   +   .   .   .   +   .   .
seq_slide   = .   x   .   .   .   x   .   .   .   x   .   .   .   x   .   .
seq_accent  = x   .   x   .   x   .   x   .   x   .   x   .   x   .   x   .
seq_vibrato = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
