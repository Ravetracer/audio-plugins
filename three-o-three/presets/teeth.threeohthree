# ThreeOhThree preset
format = 1
name = Teeth
author = ThreeOhThree
description = Beasty. Resonance at 92 %, Acc Sweep pushed to 4.5 octaves, the drive stage at 85 % and the ladder driven half again as hard as the circuit drives it, so the filter fights back instead of whistling. Almost every step is accented -- which, with Acc Build at 85 %, means the accent circuit never empties and the whole bar climbs. The line hammers the root and jumps an octave off it, with a tritone on five and fourteen to stop it being pleasant.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 600
resonance = 0.92
envmod = 0.85
decay = 220
tracking = 0

# Accent
accent = 0.95
accent_threshold = 100
accent_decay = 75

# Slide
slide_time = 40

# Drive
drive = 0.85
tone = 7000

# Output
volume = -10

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 4.5
acc_build = 0.85
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 145
res_range = 104
drift = 0

# Sequencer
mode = Sequencer
seq_rate = 1/16
seq_steps = 16
gate = 0.4
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 666
rand_scale = Blues
rand_root = C
rand_notes = 0.95
rand_accent = 0.7
rand_slide = 0.28
rand_octave = 0.45
rand_vibrato = 0.0

# Sequence
seq_pitch   = C   C   C   C   F#  C   C   A#  C   C   C   G#  C   F#  C   C
seq_octave  = .   +   .   .   .   .   +   .   .   +   .   .   .   .   +   .
seq_slide   = .   x   .   .   .   .   x   .   .   x   .   .   .   .   x   .
seq_accent  = x   x   .   x   x   .   x   x   x   x   .   x   x   x   x   .
seq_vibrato = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
