# ThreeOhThree preset
format = 1
name = Rubber Band
author = ThreeOhThree
description = Slide Time at 150 ms, more than twice the machine's own. A slide that long does not finish inside a sixteenth, so a slid note arrives at a pitch between the two it was written as -- which is a fault on paper and the reason this is on the list.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 520
resonance = 0.72
envmod = 0.6
decay = 420
tracking = 0

# Accent
accent = 0.6
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 150

# Drive
drive = 0.3
tone = 9000

# Output
volume = -7

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
