# ThreeOhThree preset
format = 1
name = Dark Engine
author = ThreeOhThree
description = The square wave, low and almost closed. The square reaches the filter 6.7 dB below the sawtooth -- the schematic prints both swings, 12 V to 5.5 V against 8 V to 5 V -- so this is quieter as well as hollower, and the master is up to compensate.

# VCO
waveform = Square
tuning = 0

# VCF
cutoff = 200
resonance = 0.55
envmod = 0.45
decay = 800
tracking = 0

# Accent
accent = 0.65
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 60

# Drive
drive = 0.25
tone = 5000

# Output
volume = -4

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
