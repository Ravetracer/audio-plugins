# ThreeOhThree preset
format = 1
name = Fifteen Steps
author = ThreeOhThree
description = The same idea with Steps set to 15. Fifteen sixteenths against a four-four bar means the pattern never lands in the same place twice -- it walks one step earlier every bar and comes back round after fifteen of them. The machine took any length from 1 to 16 and this is the whole reason why.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 500
resonance = 0.66
envmod = 0.68
decay = 320
tracking = 0

# Accent
accent = 0.68
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 55

# Drive
drive = 0.28
tone = 10000

# Output
volume = -7

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = Sequencer
seq_rate = 1/16
seq_steps = 15
gate = 0.45
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06

# Sequence
seq_pitch   = C   C   G   C   A#  C   C   D#  C   G   C   C   A#  C   C   .
seq_octave  = .   .   .   .   .   +   .   .   .   .   .   +   .   .   .   .
seq_slide   = .   x   .   .   .   .   x   .   .   .   x   .   .   .   x   .
seq_accent  = x   .   .   x   .   .   .   x   .   .   .   x   .   .   .   .
seq_vibrato = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
