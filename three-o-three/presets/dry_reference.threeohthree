# ThreeOhThree preset
format = 1
name = Dry Reference
author = ThreeOhThree
description = Every added stage switched off: no drive, the tone control fully open, and the master at unity. What comes out is the signal path the schematic draws and nothing else, which is what an A/B against a recording of the hardware needs. Start here when fitting, not at a preset with drive on it.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 500
resonance = 0.4
envmod = 0.5
decay = 600
tracking = 0

# Accent
accent = 0.6
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 60

# Drive
drive = 0
tone = 18000

# Output
volume = -6

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
