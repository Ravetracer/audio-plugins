# ThreeOhThree preset
format = 1
name = Oscillator
author = ThreeOhThree
description = Res Range at 120 %, which takes the ladder past the point where its loop oscillates. A stock 303 cannot do this and the service notes prove it: the ringing waveform printed for the TM3 alignment, taken at resonance full clockwise, dies away. Past 100 % it stops dying and the filter becomes a sine oscillator sitting on top of the note. Ladder is down to 40 % so the saturation does not flatten it.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 340
resonance = 1
envmod = 0.75
decay = 500
tracking = 0

# Accent
accent = 0.6
accent_threshold = 100
accent_decay = 90

# Slide
slide_time = 60

# Drive
drive = 0.15
tone = 12000

# Output
volume = -10

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 40
res_range = 120
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06

# Sequence
seq_pitch   = C   C   G   C   D#  C   A#  C   C   G   C   D#  C   A#  C   G
seq_octave  = .   .   .   .   .   .   .   +   .   .   .   .   .   .   .   .
seq_slide   = x   .   x   .   x   .   x   .   x   .   x   .   x   .   x   .
seq_accent  = x   .   .   x   .   .   x   .   x   .   .   x   .   .   x   .
seq_vibrato = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
