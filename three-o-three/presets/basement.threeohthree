# ThreeOhThree preset
format = 1
name = Basement
author = ThreeOhThree
description = Dark. The square wave, an octave down, with the cutoff almost shut and a decay long enough that the filter never finishes closing before the next note reopens it. The intervals are the two that have no comfort in them -- a minor second and a tritone -- and there are only seven notes in sixteen steps, so most of the bar is the tail of the last one. Acc Decay is at 600 ms rather than the machine's fixed 200, so an accent swells instead of stabbing, and the Droop is turned up to thin the square into something colder.

# VCO
waveform = Square
tuning = 0

# VCF
cutoff = 190
resonance = 0.62
envmod = 0.45
decay = 1600
tracking = 0

# Accent
accent = 0.7
accent_threshold = 100
accent_decay = 160

# Slide
slide_time = 110

# Drive
drive = 0.35
tone = 3800

# Output
volume = -5

# Mods
env_bias = 1.1
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 600
droop = 62
ladder = 100
res_range = 100
drift = 0.35

# Sequencer
mode = Sequencer
seq_rate = 1/16
seq_steps = 16
gate = 0.62
swing = 50

# Vibrato
vib_depth = 20
vib_rate = 3.2
vib_delay = 200

# Generator
rand_seed = 13
rand_scale = Phrygian
rand_root = C
rand_notes = 0.42
rand_accent = 0.14
rand_slide = 0.2
rand_octave = 0.3
rand_vibrato = 0.08

# Sequence
seq_pitch   = C   .   .   C#  .   .   C   .   F#  F#  .   .   C   .   C#  C
seq_octave  = -   .   .   -   .   .   -   .   .   .   .   .   -   .   .   -
seq_slide   = .   .   .   .   .   .   .   .   x   .   .   .   .   .   x   .
seq_accent  = x   .   .   .   .   .   .   .   x   .   .   .   .   .   .   .
seq_vibrato = .   .   .   x   .   .   .   .   .   .   .   .   .   .   .   .
