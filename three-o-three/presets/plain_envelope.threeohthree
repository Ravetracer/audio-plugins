# ThreeOhThree preset
format = 1
name = Plain Envelope
author = ThreeOhThree
description = Env Bias at zero, which switches Roland's gimmick off. Env Mod then behaves like the envelope-amount knob on every other synthesiser in the world: a deeper sweep without the start of the note getting darker to make room for it. Worth having once, next to any of the others, to hear what the circuit on page 8 of the service notes is actually buying.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 380
resonance = 0.65
envmod = 0.7
decay = 450
tracking = 0

# Accent
accent = 0.6
accent_threshold = 100
accent_decay = 200

# Slide
slide_time = 60

# Drive
drive = 0.25
tone = 10000

# Output
volume = -7

# Mods
env_bias = 0
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
