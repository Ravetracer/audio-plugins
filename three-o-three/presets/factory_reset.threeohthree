# ThreeOhThree preset
format = 1
name = Factory Reset
author = ThreeOhThree
description = The machine as the parameter table leaves it, and the reference every other preset here was built against: cutoff at the centre of its travel, which the service notes' own TM3 alignment puts at 500 Hz, and Env Mod and Resonance at the middle. Drive is at 20 %, which is the only thing here the hardware does not have.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 500
resonance = 0.35
envmod = 0.5
decay = 600
tracking = 0

# Accent
accent = 0.6
accent_threshold = 100
accent_decay = 68

# Slide
slide_time = 60

# Drive
drive = 0.2
tone = 8000

# Output
volume = -6

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0

# Sequencer
mode = MIDI
seq_rate = 1/16
seq_steps = 16
gate = 0.5
swing = 50
pattern = 1
chain_mode = Stay
chain_length = 4

# Vibrato
vib_depth = 25
vib_rate = 6
vib_delay = 60

# Generator
rand_seed = 1
rand_scale = Minor
rand_root = C
rand_notes = 0.78
rand_accent = 0.3
rand_slide = 0.2
rand_octave = 0.22
rand_vibrato = 0.06
