# ThreeOhThree preset
format = 1
name = Homesick
author = ThreeOhThree
description = Sad. Natural minor at half the speed -- eighth notes, a long decay and a gate that nearly fills its step, so notes lean into each other instead of stopping. The line falls more than it rises and ends on a D that does not resolve. Two steps carry a vibrato, delayed 120 ms so it arrives after the note rather than with it, which is the difference between a sigh and a wobble. A little Drift, because nothing in this one should be quite steady.

# VCO
waveform = Sawtooth
tuning = 0

# VCF
cutoff = 380
resonance = 0.5
envmod = 0.5
decay = 1200
tracking = 0

# Accent
accent = 0.45
accent_threshold = 100
accent_decay = 140

# Slide
slide_time = 90

# Drive
drive = 0.12
tone = 6500

# Output
volume = -6

# Mods
env_bias = 1.5
env_depth = 5
acc_sweep = 3.5
acc_build = 0.75
acc_gain = 90
acc_decay_time = 200
droop = 25
ladder = 100
res_range = 100
drift = 0.2

# Sequencer
mode = Sequencer
seq_rate = 1/8
seq_steps = 16
gate = 0.78
swing = 50

# Vibrato
vib_depth = 35
vib_rate = 4.5
vib_delay = 120

# Generator
rand_seed = 77
rand_scale = Minor
rand_root = C
rand_notes = 0.55
rand_accent = 0.16
rand_slide = 0.22
rand_octave = 0.06
rand_vibrato = 0.18

# Sequence
seq_pitch   = C   .   D#  .   G   G#  G   .   A#  .   G   F   D#  .   D   .
seq_octave  = .   .   .   .   .   .   .   .   .   .   .   .   .   .   .   .
seq_slide   = .   .   .   .   .   x   .   .   .   .   .   x   .   .   .   .
seq_accent  = x   .   .   .   .   .   .   .   x   .   .   .   .   .   .   .
seq_vibrato = .   .   x   .   .   .   .   .   .   .   x   .   .   .   .   .
