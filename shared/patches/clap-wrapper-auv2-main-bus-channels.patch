     bool hasInMain{false};
+    for (const auto &p : _inputPortCache) hasInMain |= p.isMain;
     for (const auto &p : _inputPortCache)
     {
-      inSets.insert(p.channelCount);
-      hasInMain |= p.isMain;
+      if (!hasInMain || p.isMain) inSets.insert(p.channelCount);
     }
     if (!hasInMain) inSets.insert(0);
 
     bool hasOutMain{false};
+    for (const auto &p : _outputPortCache) hasOutMain |= p.isMain;
     for (const auto &p : _outputPortCache)
     {
-      outSets.insert(p.channelCount);
-      hasOutMain |= p.isMain;
+      if (!hasOutMain || p.isMain) outSets.insert(p.channelCount);
     }
     if (!hasOutMain) outSets.insert(0);
 
