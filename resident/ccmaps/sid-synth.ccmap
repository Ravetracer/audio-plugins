# ReSIDent CC map: slot = CC[@channel] name [| value label, value label ...]
# SID SYNTH v1.0 (LukHash): its default MIDI CC SETUP. It listens on every
# channel (OMNI) once MIDI is switched on in its menu (item 01).
name = SID Synth
programs = sidsynth, sid synth, sid_synth
channel = 1
1 = 74 Cutoff
2 = 71 Resonance
3 = 85 Filter Mode | 0 Off, 32 LP, 64 BP, 96 HP
4 = 82 Filter Rate
5 = 83 Filter Cycle | 0 Off, 26 D+U, 51 U+D, 77 Up, 102 Down
6 = 86 Filter Retrig | 0 Legato, 43 Yes, 86 No
7 = 73 Attack
8 = 75 Decay
9 = 70 Sustain
10 = 72 Release
11 = 87 Env Retrig | 0 Auto, 43 Always, 86 Legato
12 = 28 Waveform | 0 Pulse, 16 Saw, 32 Tri, 48 Noise, 64 Tri+Saw, 80 Tri+Pul, 96 Saw+Pul, 112 T+S+P
13 = 1 Vib Wheel
14 = 77 Vib Freq
15 = 76 Vib Rate
16 = 79 Vib Type | 0 U+D, 32 Incr, 64 Up, 96 Down
17 = 78 Vib Delay
18 = 80 Vib Retrig | 0 No, 64 Yes
19 = 81 Vib On | 0 Off, 64 On
20 = 102 PWM Width
21 = 103 PWM Rate
22 = 104 PWM Depth
23 = 105 PWM Cycle | 0 D+U, 32 U+D, 64 Up, 96 Down
24 = 106 PWM Retrig | 0 Legato, 43 Yes, 86 No
25 = 107 PWM On | 0 Off, 64 On
26 = 22 Play Mode | 0 Arp, 19 Poly, 38 Mono, 57 5ths, 76 Oct, 95 Oct+, 114 Arp+
27 = 31 Arp Speed
28 = 23 Arp Dir | 0 Down, 43 Up, 86 Alt
29 = 30 Portamento | 0 Off, 64 On
30 = 24 Pitchbend
31 = 25 Ring Mod | 0 Off, 64 On
32 = 26 Hard Sync | 0 Off, 64 On
33 = 14 Tremolo Rate
34 = 15 Tremolo | 0 Off, 64 On
35 = 27 Click | 0 Off, 64 On
36 = 29 Preset Select
