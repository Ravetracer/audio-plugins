# ReSIDent CC map: slot = CC[@channel] name [| value label, value label ...]
# Station64 v2.6 (djindikator), from its documentation. It listens on MIDI
# channels 1-3. CCs 64-127 act as 0-63.
name = Station64
programs = sta64, station64
channel = 1
1 = 1 Cutoff
2 = 20 Resonance
3 = 57 Filter LP | 0 Off, 64 On
4 = 58 Filter BP | 0 Off, 64 On
5 = 59 Filter HP | 0 Off, 64 On
6 = 7 Volume
7 = 6 Glide
