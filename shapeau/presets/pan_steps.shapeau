# Shapeau preset
format = 1
name = Pan Steps
author = Shapeau
description = Only the low band moves: sixteen steps throw the bottom of the signal left and right while the mid and high bands hold the centre. The shape is drawn on the low band and the other two are left flat.

# Global
mix = 100
split_low = 240
split_high = 1800
band_low = On
band_mid = On
band_high = On

# Volume
vol_on = Off

# Filter
flt_on = Off

# Drive
drv_on = Off

# Crush
crs_on = Off

# Time
tim_on = Off

# Pan
pan_on = On
pan_rate = 1/1
pan_phase = 0
pan_smooth = 12

# Width
wid_on = Off

# Shape curves. One line per module and band, in normalised time
# and value, with each point's corner weight (0 hard, 1 medium, 2
# soft) and the bend of the segment leaving it (-1 .. +1).
# Bands are 0 low, 1 mid, 2 high.
curve vol 0 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve vol 1 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve vol 2 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve flt 0 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve flt 1 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve flt 2 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve drv 0 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve drv 1 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve drv 2 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve tim 0 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve tim 1 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve tim 2 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve crs 0 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve crs 1 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve crs 2 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve pan 0 = 0.0000 0.1500 0 0.000, 0.0605 0.1500 0 0.000, 0.0625 0.8500 0 0.000, 0.1230 0.8500 0 0.000, 0.1250 0.3000 0 0.000, 0.1855 0.3000 0 0.000, 0.1875 0.7000 0 0.000, 0.2480 0.7000 0 0.000, 0.2500 0.1500 0 0.000, 0.3105 0.1500 0 0.000, 0.3125 0.8500 0 0.000, 0.3730 0.8500 0 0.000, 0.3750 0.5000 0 0.000, 0.4355 0.5000 0 0.000, 0.4375 0.5000 0 0.000, 0.4980 0.5000 0 0.000, 0.5000 0.8500 0 0.000, 0.5605 0.8500 0 0.000, 0.5625 0.1500 0 0.000, 0.6230 0.1500 0 0.000, 0.6250 0.7000 0 0.000, 0.6855 0.7000 0 0.000, 0.6875 0.3000 0 0.000, 0.7480 0.3000 0 0.000, 0.7500 0.8500 0 0.000, 0.8105 0.8500 0 0.000, 0.8125 0.1500 0 0.000, 0.8730 0.1500 0 0.000, 0.8750 0.5000 0 0.000, 0.9355 0.5000 0 0.000, 0.9375 0.5000 0 0.000, 1.0000 0.5000 0 0.000
curve pan 1 = 0.0000 0.5000 0 0.000, 1.0000 0.5000 0 0.000
curve pan 2 = 0.0000 0.5000 0 0.000, 1.0000 0.5000 0 0.000
curve wid 0 = 0.0000 0.5000 0 0.000, 1.0000 0.5000 0 0.000
curve wid 1 = 0.0000 0.5000 0 0.000, 1.0000 0.5000 0 0.000
curve wid 2 = 0.0000 0.5000 0 0.000, 1.0000 0.5000 0 0.000
