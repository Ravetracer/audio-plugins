# Shapeau preset
format = 1
name = Crush Steps
author = Shapeau
description = A sixteenth-note bit and sample-rate crush drawn as sixteen steps, so the grit moves in rhythm instead of sitting still. The pattern is the same in all three bands, with a mixer at 75 % so the low end keeps some weight.

# Global
mix = 1
split_low = 180
split_high = 2600
band_low = On
band_mid = On
band_high = On

# Volume
vol_on = Off

# Filter
flt_on = Off

# Drive
drv_on = Off

# Crush
crs_on = On
crs_amount = 0.8
crs_bits = 4
crs_down = 12
crs_mix = 0.75
crs_rate = 1/1
crs_phase = 0
crs_smooth = 0.05

# Time
tim_on = Off

# Pan
pan_on = Off

# Width
wid_on = Off

# Shape curves. One line per module and band, in normalised time
# and value, with each point's corner weight (0 hard, 1 medium, 2
# soft) and the bend of the segment leaving it (-1 .. +1).
# Bands are 0 low, 1 mid, 2 high.
curve vol 0 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve vol 1 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
curve vol 2 = 0.0000 1.0000 0 0.000, 1.0000 1.0000 0 0.000
