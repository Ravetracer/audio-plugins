# Shapeau preset
format = 1
name = Gated Stabs
author = Shapeau
description = A hard sixteenth-note gate across all three bands, with the low band opened only on the off-beats so the bottom jumps while the rest of the chord is chopped. A gate shape rather than a drawn curve: the corners are what make it read.

# Global
mix = 1
split_low = 190
split_high = 2400
band_low = On
band_mid = On
band_high = On

# Volume
vol_on = On
vol_trim = 3
vol_rate = 1/16
vol_phase = 0
vol_smooth = 0

# Filter
flt_on = On
flt_cutoff = 3000
flt_res = 0.2
flt_depth = 3
flt_drive = 0
flt_type_low = Lowpass
flt_type_mid = Lowpass
flt_type_high = Highpass
flt_rate = 1/16
flt_phase = 0.45
flt_smooth = 0.1

# Drive
drv_on = Off
drv_style = Soft Clip
drv_drive = 0.4
drv_input = 0
drv_output = 0
drv_tone = 0
drv_mix = 1
drv_rate = 1/4
drv_phase = 0
drv_smooth = 0.2

# Time
tim_on = Off
tim_range = 500
tim_step = 0.3
tim_rate = 1/4
tim_phase = 0
tim_smooth = 0.1

# Shape curves. One line per module and band, in normalised time
# and value, with each point's weight: 0 hard, 1 medium, 2 soft.
# Bands are 0 low, 1 mid, 2 high.
curve vol 0 = 0.0000 0.0000 0, 0.5000 1.0000 0, 0.5600 1.0000 0, 0.5700 0.0000 0, 1.0000 0.0000 0
curve vol 1 = 0.0000 1.0000 0, 0.4000 1.0000 0, 0.4500 0.0000 0, 1.0000 0.0000 0
curve vol 2 = 0.0000 0.0000 0, 0.2500 1.0000 0, 0.3000 0.0000 0, 0.7500 1.0000 0, 0.8000 0.0000 0, 1.0000 0.0000 0
curve flt 0 = 0.0000 0.5000 1, 0.5000 1.0000 1, 1.0000 0.5000 1
curve flt 1 = 0.0000 1.0000 1, 0.5000 0.0000 1, 1.0000 1.0000 1
curve flt 2 = 0.0000 0.7000 1, 0.5000 0.2000 1, 1.0000 0.7000 1
curve drv 0 = 0.0000 1.0000 0, 1.0000 1.0000 0
curve drv 1 = 0.0000 1.0000 0, 1.0000 1.0000 0
curve drv 2 = 0.0000 1.0000 0, 1.0000 1.0000 0
curve tim 0 = 0.0000 1.0000 0, 1.0000 1.0000 0
curve tim 1 = 0.0000 1.0000 0, 1.0000 1.0000 0
curve tim 2 = 0.0000 1.0000 0, 1.0000 1.0000 0
